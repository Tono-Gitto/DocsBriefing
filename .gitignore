# API key — never commit this
.env

# Per-flight pipeline output (generated at runtime)
runs/
uploads/

# Large downloaded CSV (auto-downloads on first run)
data/airports_raw.csv

# Basemap tile store — fetched from OSM at pipeline time, shared across runs.
# Deliberately outside runs/ so the 24 h sweep leaves it alone (tile_store.py).
data/tiles/

# Generated JSON outputs (re-created by the pipeline)
data/airports.json
data/fir_notams.json
data/flight_info.json
data/route.json
data/fir_coords_learned.json

# Python cache
__pycache__/
*.pyc
*.pyo

# macOS
.DS_Store
CLAUDE.md
